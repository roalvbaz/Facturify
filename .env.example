DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_ID].supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_privada

# URL pública de la app (se usa para construir los enlaces de registro por email).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo emisor y contraseña de aplicación de Gmail (nodemailer).
EMAIL_USER=tu_correo_emisor@gmail.com
EMAIL_PASS=tu_password_de_aplicacion_de_gmail

# Clave PÚBLICA del sitio de Google reCAPTCHA v2 (la carga el frontend en login/registro).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu_recaptcha_site_key_publica

# Clave secreta del servidor de Google reCAPTCHA v2 (verificación anti-bots).
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key

# Secreto compartido para el endpoint POST /api/admin/invite
# (lo envía el backend de la web de marketing en el header `x-admin-secret`)
ADMIN_INVITE_SECRET=genera_un_secreto_largo_y_aleatorio

# Secreto compartido para el endpoint GET /api/cron/payment-reminders
# (lo envía el planificador externo en el header `x-cron-secret`).
CRON_SECRET=genera_un_secreto_largo_y_aleatorio

# Administradores de la plataforma (separados por comas). Única persona que
# ve la pantalla /invitaciones y puede enviar/copiar enlaces de registro.
ADMIN_EMAILS=tu@correo-admin.com

# Veri*factu AEAT
# Entorno por defecto para nuevas empresas. Cada empresa puede subir su propio
# certificado PFX desde Configuración (se cifra con CERT_ENCRYPTION_KEY).
AEAT_ENVIRONMENT=sandbox

# Clave AES-256 para cifrar los certificados PFX de cada empresa.
# Generar con: openssl rand -hex 32
CERT_ENCRYPTION_KEY=genera_con_openssl_rand_hex_32

# Token de autorización para el cron job de Veri*factu (GET /api/cron/verifactu).
# Generar con: openssl rand -hex 32
# Configurar en Render como variable de entorno.
VERIFACTU_CRON_SECRET=genera_con_openssl_rand_hex_32

# ── Sandbox Veri*factu (pruebas) ─────────────────────────────────────
# Certificado de PRUEBAS de la AEAT (PFX). Se usa junto con
# scripts/test-sandbox.ts para validar el envío contra preproducción.
# El certificado se obtiene en la sede de la AEAT (apartado pruebas Veri*factu).
# Indica la ruta local al .pfx, o directamente su contenido en base64.
SANDBOX_PFX_PATH=
SANDBOX_PFX_BASE64=
SANDBOX_PFX_PASSWORD=
# NIF que consta en el certificado de pruebas (emisor de la factura de prueba)
SANDBOX_NIF_EMISOR=B12345678
